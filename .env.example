# Optional: The Odds API key (https://the-odds-api.com) for multi-book sportsbook odds.
# Without it, the scanner falls back to ESPN's public feed (DraftKings lines, no key needed).
ODDS_API_KEY=

# Paper-trading knobs (all optional; defaults shown)
PAPER_BANKROLL=10000
PAPER_MAX_PER_TRADE=500
PAPER_MAX_PER_KEY=1000
PAPER_MIN_MARGIN=0.005

# Fee assumptions
KALSHI_TAKER_RATE=0.07
POLY_FEE_RATE_DEFAULT=0.05
